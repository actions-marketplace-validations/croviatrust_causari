/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=86400

/app.js
  Cache-Control: public, max-age=86400

/reports/survival/feed.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/reports/survival/latest.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/reports/survival/*/*/report.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/reports/survival/*/*/repos/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/reports/survival/*/*/report.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400

/reports/survival/*/*/card.png
  Cache-Control: public, max-age=86400

# The verifier promises to make no network request: the policy enforces it
# (connect-src 'none'), and the scripts are pinned to this origin only.
/verify/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Cache-Control: public, max-age=3600

/install.sh
  Content-Type: text/x-shellscript; charset=utf-8
  Cache-Control: public, max-age=300

/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
